# ==============================================================================
# COLORLINK · Variables de entorno
# Copia este archivo como ".env" y reemplaza los valores TU_... por los reales.
# Nunca subas el archivo .env al repositorio.
# ==============================================================================

# URL pública de la app (se usa en los enlaces de los correos)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE · base de datos, autenticación y almacenamiento de fotos
# Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------------------
# Navegador (solo para iniciar sesión). La clave pública "publishable" o "anon".
VITE_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="TU_CLAVE_PUBLICA_sb_publishable_o_anon"

# Servidor (lectura/escritura de datos). La clave "service_role" / "secret".
# ¡Solo va en el servidor! Nunca la pongas en una variable VITE_.
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="TU_CLAVE_SECRETA_service_role"

# ------------------------------------------------------------------------------
# GEMINI · asistente virtual COLORLINK IA y diagnóstico técnico
# https://aistudio.google.com/apikey
# Sin clave, el asistente funciona con respuestas básicas por palabras clave.
# ------------------------------------------------------------------------------
GEMINI_API_KEY="TU_GEMINI_API_KEY"
# Opcional: modelo a usar
GEMINI_MODEL="gemini-3.5-flash"
# Opcional: modelo de respaldo si el principal está saturado (503) y segundos máximos por intento
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# CORREO · bienvenida, proyecto recibido, cambios de estado, cotizaciones y pedidos
# Gmail o Google Workspace por SMTP. Requisitos en la cuenta de Google:
#   1. Activar la verificación en 2 pasos.
#   2. Crear una "contraseña de aplicación": https://myaccount.google.com/apppasswords
# Límite aproximado: 500 correos/día (Gmail) o 2.000/día (Workspace).
# Sin estas variables, los correos se registran en la tabla correos_enviados como OMITIDO.
# Alternativa disponible: EMAIL_PROVIDER="resend" con RESEND_API_KEY.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="gmail"
GMAIL_USER="TU_CORREO@gmail.com"
GMAIL_APP_PASSWORD="TU_CONTRASENA_DE_APLICACION"
# Opcional: nombre visible del remitente (debe usar la misma cuenta de Gmail)
EMAIL_FROM="COLORLINK <TU_CORREO@gmail.com>"
# Opcional: correo del equipo que recibe avisos de nuevos proyectos y pedidos
EMAIL_NOTIFICACIONES_INTERNAS=""

# ------------------------------------------------------------------------------
# TIENDA
# ------------------------------------------------------------------------------
COSTO_ENVIO="15000"
ENVIO_GRATIS_DESDE="300000"
# Texto que reciben los clientes que pagan por transferencia
DATOS_TRANSFERENCIA="Banco XXX, cuenta de ahorros 000-000000-00 a nombre de COLORLINK S.A.S., NIT 000.000.000-0."

# Solo para el perfil "funnel" (link fijo gratis con Tailscale). Se usa en el PRIMER arranque;
# después la sesión queda guardada en el volumen tailscale-estado.
# Tailscale → Settings → Keys → Generate auth key.
TS_AUTHKEY=""
